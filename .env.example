# ---------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------
# Browser key — used by Maps JS and Places Autocomplete.
# MUST be restricted by HTTP referrer to your domains, and by API to
# "Maps JavaScript API" + "Places API" only. It is public by nature; the
# referrer restriction is what protects it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional cloud-managed Map ID. Required for AdvancedMarkerElement; when
# set, map styling comes from the cloud style instead of DARK_MAP_STYLE.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server key — used only by the Routes API proxy at /api/routes.
# MUST be restricted by IP address and to the "Routes API" only.
# Never prefix this with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=

# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. Server-only, never sent to the browser.
# Used by admin server actions and anonymous plan creation.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
