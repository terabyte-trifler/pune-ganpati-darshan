# ---------------------------------------------------------------------
# Map tiles
# ---------------------------------------------------------------------
# None required. The map uses MapLibre GL with OpenFreeMap vector tiles,
# which need no API key, no account and no billing. Attribution to
# OpenStreetMap contributors is rendered on the map and is required.

# ---------------------------------------------------------------------
# Routing (optional)
# ---------------------------------------------------------------------
# Road routing degrades gracefully: with nothing set the planner uses local
# distance estimates, clearly labelled as estimates in the UI.
#
# OSRM is used by default and needs no key. The public demo server is fine
# for development but is NOT for production — point this at your own
# instance before launch.
ROUTING_OSRM_URL=https://router.project-osrm.org

# OpenRouteService: free tier, signup but no card. Preferred when set —
# it has a real quota and better two-wheeler modelling for India.
# Server-only; never prefix with NEXT_PUBLIC_.
OPENROUTESERVICE_API_KEY=

# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. Server-only, never sent to the browser.
# Used by admin server actions and analytics writes.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salt for the crowd IP-throttle digest. Optional, but set it in
# production: IPv4 has only ~4 billion values, so an unsalted digest is
# reversible by anyone who obtains the table. See docs/05-crowd.md.
CROWD_IP_SALT=

# Enables GET /api/crowd/metrics when set, and it must be supplied on the
# request. Leave empty and the endpoint returns 404 — an endpoint that
# answers "unauthorised" has confirmed it exists.
CROWD_METRICS_TOKEN=
